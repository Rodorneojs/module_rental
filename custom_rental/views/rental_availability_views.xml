<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search View -->
    <record id="view_rental_availability_search" model="ir.ui.view">
        <field name="name">rental.availability.search</field>
        <field name="model">rental.availability</field>
        <field name="arch" type="xml">
            <search string="Buscar disponibilidad">
                <filter string="Hoy" name="filter_today"
                        domain="[('date_from', '&lt;=', context_today()), ('date_to', '&gt;=', context_today())]"/>
                <filter string="Activo" name="filter_active" domain="[('state','=','active')]"/>
                <filter string="Reservado" name="filter_reserved" domain="[('state','=','reserved')]"/>
                <filter string="Cancelado" name="filter_cancelled" domain="[('state','=','cancelled')]"/>
                <filter name="filter_boat" string="Embarcación..."
                        domain="[]" context="{'search_default_boat_id': 1}"/>
                <field name="boat_id" string="Embarcación"/>
                <field name="date_from" string="Fecha Inicio"/>
                <field name="date_to" string="Fecha Fin"/>
                <field name="state" string="Estado"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Por Embarcación" name="group_by_boat" context="{'group_by':'boat_id'}"/>
                    <filter string="Por Estado" name="group_by_state" context="{'group_by':'state'}"/>
                    <filter string="Por Mes" name="group_by_month" context="{'group_by':'date_from:month'}"/>
                </group>
                <searchpanel>
                    <field name="boat_id" icon="fa-ship" enable_counters="1" select="multi"/>
                    <field name="state" icon="fa-tag" enable_counters="1" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>
    
    <!-- Acción -->
    <record id="action_rental_availability" model="ir.actions.act_window">
        <field name="name">Periodos Disponibles</field>
        <field name="res_model">rental.availability</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="context">{'default_view_mode': 'calendar', 'search_default_today': 1}</field>
        <field name="search_view_id" ref="view_rental_availability_search"/>
    </record>
    
    <!-- Menús -->
    <menuitem id="menu_rental_availability"
              name="Disponibilidad"
              parent="sale_renting.rental_menu_root"
              sequence="15"/>
    <menuitem id="menu_rental_periods"
              name="Periodos Disponibles"
              parent="menu_rental_availability"
              action="action_rental_availability"
              sequence="1"/>
    
    <!-- Lista -->
    <record id="view_rental_availability_list" model="ir.ui.view">
        <field name="name">rental.availability.list</field>
        <field name="model">rental.availability</field>
        <field name="arch" type="xml">
            <list>
                <field name="boat_id" string="Embarcación"/>
                <field name="date_from" string="Fecha Inicio"/>
                <field name="date_to" string="Fecha Fin"/>
                <field name="state" string="Estado"/>
                <field name="notes" string="Observaciones"/>
            </list>
        </field>
    </record>
    
    <!-- Formulario: usar RANGO (sin hora) -->
    <record id="view_rental_availability_form" model="ir.ui.view">
        <field name="name">rental.availability.form</field>
        <field name="model">rental.availability</field>
        <field name="arch" type="xml">
            <form string="Disponibilidad para Alquiler">
                <group>
                    <field name="boat_id"/>
                    <!-- Rango de fechas (sustituye a date_from/date_to visibles) -->
                    <field name="date_from_dt"
                           widget="daterange"
                           required="1"
                           options="{'end_date_field': 'date_to_dt'}"
                           string="Fechas Desde y Hasta"/>
                    <field name="date_to_dt" invisible="1"/>
                    <field name="state"/>
                    <field name="notes"/>
                </group>
            </form>
        </field>
    </record>
    
    <!-- Calendario -->
    <record id="view_rental_availability_calendar" model="ir.ui.view">
        <field name="name">rental.availability.calendar</field>
        <field name="model">rental.availability</field>
        <field name="arch" type="xml">
            <calendar string="Disponibilidad de Alquiler"
                      date_start="date_from"
                      date_stop="date_to"
                      color="state"
                      mode="month">
                <field name="display_name"/>
                <field name="boat_id"/>
                <field name="notes"/>
            </calendar>
        </field>
    </record>
    
    <!-- Inherit del Gantt (sin cambios funcionales aquí) -->
    <record id="custom_rental_rental_schedule_view_gantt_inherit_status"
            model="ir.ui.view">
        <field name="name">custom_rental.rental_schedule.gantt.inherit.status</field>
        <field name="model">sale.rental.schedule</field>
        <field name="inherit_id" ref="sale_renting.rental_schedule_view_gantt"/>
        <field name="priority" eval="9999"/>
        <field name="arch" type="xml">
            <xpath expr="//gantt/field[last()]" position="after">
                <field name="x_status_label"/>
            </xpath>
            <xpath expr="//div[@t-name='gantt-popover']/div[4]" position="replace">
                <div>
                    <strong>Status — </strong>
                    <t t-if="late">
                        Late
                        <t t-if="report_line_status == 'reserved'">Pickup</t>
                        <t t-elif="report_line_status == 'pickedup'">Return</t>
                    </t>
                    <t t-else="">
                        <t t-if="x_status_label"><t t-esc="x_status_label"/></t>
                        <t t-elif="state in ['draft','sent']">Quotation</t>
                        <t t-elif="report_line_status == 'pickedup'">Picked-Up</t>
                        <t t-elif="report_line_status == 'returned'">Returned</t>
                        <t t-else="">Reserved</t>
                    </t>
                </div>
            </xpath>
        </field>
    </record>
</odoo>