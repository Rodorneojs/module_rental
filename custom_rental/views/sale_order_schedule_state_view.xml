<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inserta/ajusta el statusbar de x_schedule_state en la vista de Renting -->
    <record id="view_rental_order_form_inherit_xschedule" model="ir.ui.view">
        <field name="name">rental.order.form.inherit.xschedule</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_renting.rental_order_primary_form_view"/>
        <field name="arch" type="xml">
            
            <!-- Insertamos nuestro statusbar luego del nativo -->
            <xpath expr="//field[@name='state']" position="after">
                <field name="x_schedule_state"
                       widget="statusbar"
                       options="{'clickable': True}"
                       statusbar_visible="available,private_use,request,pay_pending,option,pre_onboard,confirmed,cancelled,invoiced"/>
            </xpath>
            
        </field>
    </record>
</odoo>
