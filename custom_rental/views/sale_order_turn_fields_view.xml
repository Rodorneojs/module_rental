<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_turn_fields_inherit" model="ir.ui.view">
        <field name="name">sale.order.turn.fields.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_renting.rental_order_primary_form_view"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_turn_yacht_id"/>
                <field name="x_turn_season_id"/>
            </xpath>
            <!-- 2) Ocultar el campo antiguo de embarcación (si existe en la vista base) -->
            <xpath expr="//field[@name='embarcacion_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <!-- 3) Reemplazar el PRIMER rental_start_date por un bloque “Rental Period” -->
            <xpath expr="(//field[@name='rental_start_date'])[1]" position="replace">
                <!-- OJO: label sin 'for' para evitar error; solo estilo de rótulo -->
                <div class="o_row" style="align-items:center;">
                    <span class="o_form_label" style="margin-right:12px;">Rental Period</span>
                    <field name="rental_start_date" widget="datetime" class="oe_inline" style="margin-right:8px;"/>
                    <span class="oe_inline" style="margin:0 8px;">→</span>
                    <field name="rental_return_date" widget="datetime" class="oe_inline"/>
                </div>
            </xpath>
            
            <!-- 4) Eliminar el PRIMER rental_return_date original (ya lo mostramos arriba) -->
            <xpath expr="(//field[@name='rental_return_date'])[1]" position="replace"/>
            
        </field>
    </record>
</odoo>