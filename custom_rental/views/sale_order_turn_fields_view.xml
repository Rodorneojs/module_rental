<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_turn_fields_inherit" model="ir.ui.view">
        <field name="name">sale.order.turn.fields.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_renting.rental_order_primary_form_view"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_turn_yacht_id"/>
                <field name="x_turn_season_id"/>
            </xpath>
            
            <xpath expr="//field[@name='embarcacion_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <xpath expr="//label[@for='duration_days']" position="before">
                <label for="rental_period_display" string="Rental Period" invisible="not x_turn_slot"/>
                <div invisible="not x_turn_slot">
                    <field name="rental_period_display"/>
                </div>
                
                <label for="rental_start_date" string="Rental Period" invisible="x_turn_slot"/>
                <div class="o_row" invisible="x_turn_slot">
                    <field name="rental_start_date" widget="datetime" class="oe_inline" style="margin-right: 16px;"/>
                    <span class="oe_inline" style="margin: 0 8px;">→</span>
                    <field name="rental_return_date" widget="datetime" class="oe_inline"/>
                </div>
            </xpath>
            
            <xpath expr="//field[@name='rental_start_date']" position="replace"/>
            <xpath expr="//field[@name='rental_return_date']" position="replace"/>
            <xpath expr="//label[@for='duration_days']" position="replace"/>
            <xpath expr="//div[hasclass('o_row')][.//field[@name='duration_days']]" position="replace"/>
            
        </field>
    </record>
</odoo>