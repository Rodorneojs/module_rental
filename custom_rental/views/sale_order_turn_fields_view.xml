<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_turn_fields" model="ir.ui.view">
        <field name="name">sale.order.turn.fields.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            
            <!-- 1) Campos nuevos debajo del cliente -->
            <xpath expr="//sheet//group//field[@name='partner_id']" position="after">
                <field name="x_turn_yacht_id"/>
                <field name="x_turn_season_id"/>
            </xpath>
            
            <!-- 2) Ocultar SIEMPRE el campo antiguo de embarcación -->
            <xpath expr="//field[@name='embarcacion_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <!-- 3) PRIMERA aparición de Start/Return:
                 ocultar si es NUEVA (not id) **o** si proviene de Turnos (x_turn_slot) -->
            <xpath expr="(//field[@name='rental_start_date'])[1]" position="replace">
                <field name="rental_start_date" invisible="not id or x_turn_slot"/>
            </xpath>
            <xpath expr="(//field[@name='rental_return_date'])[1]" position="replace">
                <field name="rental_return_date" invisible="not id or x_turn_slot"/>
            </xpath>
            
            <!-- Nota: no tocamos las otras apariciones porque las usa la fila “Rental period” -->
        </field>
    </record>
</odoo>
