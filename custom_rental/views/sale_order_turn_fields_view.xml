<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Inherit del formulario de Pedido de Venta (Rental) -->
  <record id="view_order_form_turn_fields" model="ir.ui.view">
    <field name="name">sale.order.turn.fields.inherit</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">

      <!-- 1) Insertar campos nuevos debajo del cliente -->
      <xpath expr="//sheet//group//field[@name='partner_id']" position="after">
        <field name="x_turn_yacht_id"/>
        <field name="x_turn_season_id"/>
      </xpath>

      <!-- 2) Ocultar SIEMPRE el campo antiguo de embarcación -->
      <xpath expr="//field[@name='embarcacion_id']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>

      <!-- 3) Ocultar SOLO la PRIMERA aparicion de Start/Return cuando es NUEVO (id=False)
             Deja intactos los fields que usa la fila “Rental period” -->
      <xpath expr="(//field[@name='rental_start_date'])[1]" position="replace">
        <field name="rental_start_date" invisible="not id"/>
      </xpath>
      <xpath expr="(//field[@name='rental_return_date'])[1]" position="replace">
        <field name="rental_return_date" invisible="not id"/>
      </xpath>

    </field>
  </record>
</odoo>
